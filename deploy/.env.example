# 复制为 .env 后按需修改：cp .env.example .env
# 禁止把真实的 LLM_API_KEY 提交进 git

MYSQL_ROOT_PASSWORD=chatbi_root
MYSQL_PORT=3306
REDIS_PORT=6379
API_PORT=8000

# 只读账号密码（与 warehouse/01 中的 GRANT 保持一致）
CHATBI_RO_PASSWORD=chatbi_ro

# 模型：DeepSeek / Qwen / 任意 OpenAI 兼容服务
# provider=openai 走 /chat/completions；provider=ollama 走本地原生 /api/chat
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 仅 ollama 生效：0 关闭思考链（qwen3.5 等思考模型必须关，否则 content 为空）
LLM_THINK=0
LLM_TIMEOUT=60

# 本地无 key 时的 Ollama 配置示例：
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434
# LLM_MODEL=qwen3.5:4b

# hashing（默认，离线可跑） / bge（需安装 sentence-transformers 并挂载模型）
EMBEDDER=hashing
EMBEDDER_MODEL=BAAI/bge-m3

CORS_ORIGINS=*
